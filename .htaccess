ErrorDocument 404 /404.html
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^vargersoft\.com$ [NC]
  RewriteRule ^(.*)$ https://www.vargersoft.com/$1 [R=301,L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|webp|png|jpg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
AddType text/plain .txt
AddCharset UTF-8 .txt .html .xml
